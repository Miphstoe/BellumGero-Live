package server.zone.objects.mission;

import engine.core.ManagedObject;
include system.util.SortedVector;
include system.util.VectorMap;

class PlayerBounty extends ManagedObject {
	protected unsigned long targetPlayerID;

	// Legacy combined reward field. Pre-split records (schemaVersion < 1) store
	// their total here; it is migrated into jediReward/playerPlacedReward on
	// load and is not authoritative once schemaVersion >= 1. Kept only so old
	// serialized objects deserialize without crashing.
	protected int reward;

	// 0 = legacy/unmigrated record, 1 = split jedi/player-placed reward accounting.
	protected int schemaVersion;

	// Reward attributable to the target's own Jedi bounty (set from
	// calculateBhReward()); independent of any player-funded contribution.
	protected int jediReward;

	// Sum of all player-funded contributions currently active on this target.
	protected int playerPlacedReward;

	// True while a player-funded bounty is active (unconsumed) on this target.
	protected boolean playerPlacedBountyActive;

	// True once the player-funded portion has been paid out by a bounty
	// hunter; the funded reward/placers are cleared and must never be reused.
	protected boolean playerPlacedBountyConsumed;

	protected boolean online;

	protected unsigned long lastBountyKill;

	protected unsigned long lastBountyDebuff;

	@dereferenced
	protected SortedVector<unsigned long> bountyHunterIDs;

	@dereferenced
	protected VectorMap<unsigned long, unsigned long> missionCooldownList;

	@dereferenced
	protected VectorMap<unsigned long, int> bountyPlacers;

	// jediPayout is the Jedi-bounty reward component only (0 when this record
	// is being created purely to hold a player-funded bounty on a non-Jedi
	// target). Player-funded reward must be added afterward via
	// addBountyPlacer(), exactly once per placement, never through this
	// constructor.
	public PlayerBounty(unsigned long targetID, int jediPayout) {
		targetPlayerID = targetID;
		schemaVersion = 1;
		jediReward = jediPayout;
		playerPlacedReward = 0;
		playerPlacedBountyActive = false;
		playerPlacedBountyConsumed = false;
		reward = jediPayout;
		online = true;
		bountyHunterIDs.setNoDuplicateInsertPlan();
		missionCooldownList.setNoDuplicateInsertPlan();
		bountyPlacers.setNoDuplicateInsertPlan();
		lastBountyKill = 0;
		lastBountyDebuff = 0;
	}

	// Sets the Jedi-bounty reward component only. Must never touch
	// playerPlacedReward -- Jedi reward recalculation (e.g. on login or
	// force_discipline change) must not overwrite a funded player bounty.
	public void setJediReward(int amount) {
		jediReward = amount;
		reward = amount;
	}

	public void setOnline(boolean state) {
		online = state;
	}

	@read
	public unsigned long getTargetPlayerID() {
		return targetPlayerID;
	}

	// Effective terminal-facing total: the Jedi reward plus the player-funded
	// reward, but only while the player-funded portion is active and has not
	// already been paid out.
	@read
	public int getReward() {
		int total = jediReward;

		if (playerPlacedBountyActive && !playerPlacedBountyConsumed) {
			total = total + playerPlacedReward;
		}

		return total;
	}

	@read
	public int getJediReward() {
		return jediReward;
	}

	@read
	public int getPlayerPlacedReward() {
		return playerPlacedReward;
	}

	@read
	public boolean isPlayerPlacedBountyActive() {
		return playerPlacedBountyActive && !playerPlacedBountyConsumed;
	}

	@read
	public boolean isPlayerPlacedBountyConsumed() {
		return playerPlacedBountyConsumed;
	}

	@read
	public int getSchemaVersion() {
		return schemaVersion;
	}

	public void setSchemaVersion(int version) {
		schemaVersion = version;
	}

	// Pays out and permanently clears the player-funded portion of this
	// bounty. Safe to call more than once: once consumed, subsequent calls
	// are no-ops that cannot re-arm or duplicate the reward.
	public void consumePlayerPlacedBounty() {
		if (playerPlacedBountyConsumed) {
			return;
		}

		playerPlacedReward = 0;
		playerPlacedBountyActive = false;
		playerPlacedBountyConsumed = true;
		bountyPlacers.removeAll();
	}

	// Legacy-schema migration only: bountyPlacers already holds correct
	// per-placer amounts from before the reward-accounting split, so this
	// recomputes playerPlacedReward as their sum without re-adding through
	// addBountyPlacer() (which would double the totals it is meant to fix).
	// Implemented native: chained VectorMap accessor calls (elementAt(i).getKey())
	// are not reliably code-generated from inline IDL method bodies.
	public native void recalculatePlayerPlacedRewardFromExistingPlacers();

	@read
	public boolean isOnline() {
		return online;
	}

	@read
	public int numberOfActiveMissions() {
		return bountyHunterIDs.size();
	}

	public void addBountyHunter(unsigned long id) {
		bountyHunterIDs.put(id);
	}

	public void removeBountyHunter(unsigned long id) {
		bountyHunterIDs.drop(id);
	}

	@read
	public boolean hasBountyHunter(unsigned long id) {
		return bountyHunterIDs.contains(id);
	}

	@local
	@read
	public final SortedVector<unsigned long> getBountyHunters() {
		return bountyHunterIDs;
	}

	@read
	public unsigned long getLastBountyKill() {
		return lastBountyKill;
	}

	public void setLastBountyKill(unsigned long newTime) {
		lastBountyKill = newTime;
	}

	@read
	public unsigned long getLastBountyDebuff() {
	    return lastBountyDebuff;
	}

	public void setLastBountyDebuff(unsigned long newTime) {
	    lastBountyDebuff = newTime;
	}
	
	public native boolean canTakeMission(unsigned long enemyID, unsigned long cooldownTime);
	public void addMissionCooldown(unsigned long enemyID, unsigned long newTime) {
		missionCooldownList.put(enemyID, newTime);
	}

	// Adds a player-funded contribution exactly once: bountyPlacers tracks who
	// paid what, and playerPlacedReward is the sole reward accumulator for
	// this component. This must never also flow through the constructor's
	// jediPayout or through setJediReward(), or the amount is counted twice.
	public void addBountyPlacer(unsigned long placerID, int amount) {
		if (bountyPlacers.contains(placerID)) {
			int currentAmount = bountyPlacers.get(placerID);
			bountyPlacers.put(placerID, currentAmount + amount);
		} else {
			bountyPlacers.put(placerID, amount);
		}

		playerPlacedReward = playerPlacedReward + amount;
		playerPlacedBountyActive = true;
		playerPlacedBountyConsumed = false;
	}

	@read
	public boolean hasBountyPlacer(unsigned long placerID) {
		return bountyPlacers.contains(placerID);
	}

	@read
	public int getBountyPlacerAmount(unsigned long placerID) {
		if (bountyPlacers.contains(placerID)) {
			return bountyPlacers.get(placerID);
		}
		return 0;
	}

	@local
	@read
	public final VectorMap<unsigned long, int> getBountyPlacers() {
		return bountyPlacers;
	}

	@read
	public int getNumberOfBountyPlacers() {
		return bountyPlacers.size();
	}
}
