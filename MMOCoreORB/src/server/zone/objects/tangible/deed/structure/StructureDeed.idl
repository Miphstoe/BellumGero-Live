package server.zone.objects.tangible.deed.structure;

import server.zone.objects.structure.StructureObject;
import server.zone.objects.creature.CreatureObject;
import server.zone.objects.tangible.deed.Deed;
import system.util.Vector;
include server.zone.packets.scene.AttributeListMessage;
include server.zone.objects.tangible.deed.components.PlaceStructureComponent;
include server.zone.objects.manufactureschematic.craftingvalues.CraftingValues;

@json
class StructureDeed extends Deed {
	protected unsigned int surplusMaintenance;
	protected unsigned int surplusPower;
	protected float extractionRate;
	protected float hopperSizeMax;

	protected float maintenanceReductionBonus;
	protected int storageBonus;

	/**
	 * House Pack-Up transactional state carried on the deed itself:
	 * 0 = NONE, 1 = PACKED, 2 = RESTORING, 3 = CONSUMED, 4 = PARTIAL (needs admin review).
	 * Persisted through normal deed persistence (the same mechanism that already
	 * reliably preserves surplusMaintenance/surplusPower), so it survives logout,
	 * restart, and indefinite time in inventory -- unlike the legacy RAM-hashtable/
	 * external-file tracking it replaces. Also used to make restoration idempotent:
	 * a deed can only be restored once (see HousePackupManager::restoreFromDeed).
	 */
	protected int housePackState;

	@dereferenced
	protected Vector<byte> housePackedPayload;

	protected unsigned int housePackedItemCount;

	protected unsigned int housePackTimestamp;

	protected unsigned long housePackedOriginalStructureID;

	protected transient PlaceStructureComponent placeStructureComponent;

	public StructureDeed() {
		Logger.setLoggingName("StructureDeed");

		surplusMaintenance = 0;
		surplusPower = 0;
		extractionRate = 0;
		hopperSizeMax = 0;
		maintenanceReductionBonus = 0;
		storageBonus = 0;

		housePackState = 0;
		housePackedItemCount = 0;
		housePackTimestamp = 0;
		housePackedOriginalStructureID = 0;
	}

	@local
	@dirty
	public native void fillAttributeList(AttributeListMessage alm, CreatureObject object);

	public native int handleObjectMenuSelect(CreatureObject player, byte selectedID);

	public native void initializeTransientMembers();

	@local
	public native void updateCraftingValues(CraftingValues values, boolean firstUpdate = false);

	public int placeStructure(CreatureObject creature, float x, float y, int angle) {
		if (placeStructureComponent) {
			return placeStructureComponent.placeStructure(this, creature, x, y, angle);
		}

		return 1;
	}

	public int notifyStructurePlaced(CreatureObject creature, StructureObject structure) {
		if (placeStructureComponent) {
			return placeStructureComponent.notifyStructurePlaced(this, creature, structure);
		}

		return 1;
	}

	public void setSurplusMaintenance(unsigned int maint) {
		surplusMaintenance = maint;
	}

	public void setSurplusPower(unsigned int power) {
		surplusPower = power;
	}

	public void setExtractionRate(float rate) {
		extractionRate = rate;
	}

	public void setHopperSize(float size) {
		hopperSizeMax = size;
	}

	@read
	public unsigned int getSurplusMaintenance() {
		return surplusMaintenance;
	}

	@read
	public unsigned int getSurplusPower() {
		return surplusPower;
	}

	@read
	public float getExtractionRate() {
		return extractionRate;
	}

	@read
	public float getHopperSize() {
		return hopperSizeMax;
	}

	public void setMaintenanceReductionBonus(float bonus) {
		maintenanceReductionBonus = bonus;
	}

	public void setStorageBonus(int bonus) {
		storageBonus = bonus;
	}

	@read
	public float getMaintenanceReductionBonus() {
		return maintenanceReductionBonus;
	}

	@read
	public int getStorageBonus() {
		return storageBonus;
	}

	@preLocked
	public void setHousePackState(int state) {
		housePackState = state;
	}

	@read
	public int getHousePackState() {
		return housePackState;
	}

	/**
	 * True whenever this deed is currently holding packed structure contents that
	 * have not yet been fully, successfully restored. Used to gate destructive or
	 * ownership-transferring operations on the deed (destroy, trade, vendor sale,
	 * Bazaar listing) so hundreds of player items can't be stranded by losing the
	 * only reference that can recover them.
	 */
	@read
	public boolean isPackedWithContents() {
		return housePackState == 1 || housePackState == 2 || housePackState == 4;
	}

	// Implemented by hand in StructureDeedImplementation.cpp -- idlc's body
	// codegen always takes the address of an object-typed argument passed to a
	// nested call, which is incompatible with Vector::addAll's reference
	// parameter. A native method sidesteps idlc's body translation entirely.
	@local
	@preLocked
	public native void setHousePackedPayload(@dereferenced Vector<byte> payload);

	@preLocked
	public void clearHousePackedPayload() {
		housePackedPayload.removeAll();
	}

	@read
	public boolean hasHousePackedPayload() {
		return housePackedPayload.size() > 0;
	}

	@local
	@read
	public final Vector<byte> getHousePackedPayload() {
		return housePackedPayload;
	}

	@preLocked
	public void setHousePackedItemCount(unsigned int count) {
		housePackedItemCount = count;
	}

	@read
	public unsigned int getHousePackedItemCount() {
		return housePackedItemCount;
	}

	@preLocked
	public void setHousePackTimestamp(unsigned int timestamp) {
		housePackTimestamp = timestamp;
	}

	@read
	public unsigned int getHousePackTimestamp() {
		return housePackTimestamp;
	}

	@preLocked
	public void setHousePackedOriginalStructureID(unsigned long oid) {
		housePackedOriginalStructureID = oid;
	}

	@read
	public unsigned long getHousePackedOriginalStructureID() {
		return housePackedOriginalStructureID;
	}

	@dirty
	public boolean isStructureDeed() {
		return true;
	}
}
